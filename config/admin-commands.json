{
  "schemaVersion": "1.0.0",
  "backend": [
    { "id": "help", "command": "help", "description": "List the current backend command allowlist", "output": "JSON command catalog" },
    { "id": "health", "command": "health", "description": "Check live website API health", "output": "Service and API version" },
    { "id": "catalog:list", "command": "catalog:list", "description": "Count beat catalog tracks", "output": "Catalog track count" },
    { "id": "models:list", "command": "models:list", "description": "Show configured OpenAI/Ollama model routes", "output": "Provider configuration without secrets" },
    { "id": "reference:stats", "command": "reference:stats", "description": "Show analyzer reference-pool status", "output": "Active reference count and storage availability" },
    { "id": "deploy:status", "command": "deploy:status", "description": "Show unified Pages deployment authority", "output": "Repository, branch, Pages project, and architecture" },
    { "id": "sales:list", "command": "sales:list", "description": "Show historical beta sales", "output": "Historical sale records from compatibility KV" },
    { "id": "inquiries:list", "command": "inquiries:list", "description": "Show recorded contact inquiries", "output": "Recent inquiry records" },
    { "id": "export:site", "command": "export:site", "description": "Show the authenticated site export route", "output": "Canonical site export route" },
    { "id": "export:tracks", "command": "export:tracks", "description": "Show the authenticated track-analysis export route", "output": "Canonical track-analysis export route" }
  ],
  "androidLocal": [
    { "id": "local:pwd", "command": "action:local:pwd", "shell": "pwd", "description": "Show the app shell working directory" },
    { "id": "local:files", "command": "action:local:files", "shell": "ls -la", "description": "List files in the app shell working directory" },
    { "id": "local:storage", "command": "action:local:storage", "shell": "df -h", "description": "Show filesystem usage" },
    { "id": "local:usage", "command": "action:local:usage", "shell": "du -sh .", "description": "Show the current directory size" },
    { "id": "local:identity", "command": "action:local:identity", "shell": "id", "description": "Show the app-shell identity" },
    { "id": "local:system", "command": "action:local:system", "shell": "uname -a", "description": "Show kernel and system details" },
    { "id": "local:processes", "command": "action:local:processes", "shell": "ps -A", "description": "List processes visible to the app shell" },
    { "id": "local:network", "command": "action:local:network", "shell": "ip addr; ip route", "description": "Show network addresses and routes" },
    { "id": "local:environment", "command": "action:local:environment", "shell": "printenv | sort", "description": "List the local process environment" },
    { "id": "termux:packages", "command": "action:termux:packages", "shell": "if command -v pkg >/dev/null 2>&1; then pkg list-installed; else echo 'Termux pkg is not available'; fi", "description": "List installed Termux packages when available" },
    { "id": "termux:info", "command": "action:termux:info", "shell": "if command -v termux-info >/dev/null 2>&1; then termux-info; else echo 'termux-info is not available'; fi", "description": "Show Termux environment information when available" },
    { "id": "android:version", "command": "action:android:version", "shell": "getprop ro.build.version.release", "description": "Show the Android OS version" },
    { "id": "android:packages", "command": "action:android:packages", "shell": "pm list packages -3", "description": "List third-party Android packages visible to the app" },
    { "id": "android:logs", "command": "action:android:logs", "shell": "logcat -d -t 100", "description": "Show recent logs accessible to the app" },
    { "id": "site:health", "command": "action:site:health", "shell": "curl -fsS https://north3rnlight3r.com/api/health", "description": "Check production API health from the device" }
  ]
}
