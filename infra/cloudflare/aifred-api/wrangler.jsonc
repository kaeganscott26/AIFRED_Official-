{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aifred-api",
  "main": "src/index.js",
  "compatibility_date": "2026-09-08",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "north3rnlight3r.com/api/*",
      "zone_name": "north3rnlight3r.com"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": false,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  },
  "vars": {
    "AIFRED_PUBLIC_ORIGIN": "https://north3rnlight3r.com",
    "AIFRED_API_BASE_URL": "https://north3rnlight3r.com/api",
    "AIFRED_GITHUB_REPO": "kaeganscott26/AIFRED_Official-",
    "AIFRED_GITHUB_BRANCH": "main",
    "AIFRED_PAGES_PROJECT": "aifred-site",
    "AIFRED_CHAT_PROVIDER": "ollama",
    "OLLAMA_BASE_URL": "https://ollama.north3rnlight3r.com",
    "OLLAMA_MODEL": "aifred:latest",
    "AIFRED_CONTACT_EMAIL": "north3rnlight3rofficial@outlook.com"
  },
  "kv_namespaces": [
    {
      "binding": "AIFRED_REFERENCE_POOL",
      "id": "8a120701767e474f928d1af7037cd68a"
    },
    {
      "binding": "AIFRED_SALES_LOG",
      "id": "2c66da7795b54135a4d67e514b97491f"
    }
  ],
  "r2_buckets": [
    {
      "binding": "AIFRED_DOWNLOADS",
      "bucket_name": "aifred-downloads"
    },
    {
      "binding": "AIFRED_REFERENCE_BUCKET",
      "bucket_name": "aifred-reference-pool"
    }
  ],
  "d1_databases": [
    {
      "binding": "AIFRED_OPS",
      "database_name": "aifred-ops",
      "database_id": "60d95cd8-d1da-486c-b6fd-4bfedcd7bc47",
      "migrations_dir": "migrations"
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "AIFRED_ANALYTICS",
      "dataset": "aifred_events"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "AIFRED_EVENTS_QUEUE",
        "queue": "aifred-events"
      }
    ],
    "consumers": [
      {
        "queue": "aifred-events",
        "max_batch_size": 100,
        "max_batch_timeout": 30,
        "max_retries": 3
      }
    ]
  },
  "ratelimits": [
    {
      "name": "CHAT_RATE_LIMITER",
      "namespace_id": "4101",
      "simple": { "limit": 15, "period": 60 }
    },
    {
      "name": "ANALYTICS_RATE_LIMITER",
      "namespace_id": "4102",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "ADMIN_LOGIN_RATE_LIMITER",
      "namespace_id": "4103",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "INQUIRY_RATE_LIMITER",
      "namespace_id": "4104",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "REFERENCE_RATE_LIMITER",
      "namespace_id": "4105",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "ANALYSIS_RATE_LIMITER",
      "namespace_id": "4106",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "ADMIN_RATE_LIMITER",
      "namespace_id": "4107",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "env": {
    "staging": {
      "name": "aifred-api-staging",
      "workers_dev": true,
      "preview_urls": false,
      "routes": [],
      "vars": {
        "AIFRED_PUBLIC_ORIGIN": "https://north3rnlight3r.com",
        "AIFRED_API_BASE_URL": "https://north3rnlight3r.com/api",
        "AIFRED_GITHUB_REPO": "kaeganscott26/AIFRED_Official-",
        "AIFRED_GITHUB_BRANCH": "main",
        "AIFRED_PAGES_PROJECT": "aifred-site",
        "AIFRED_CHAT_PROVIDER": "ollama",
        "OLLAMA_BASE_URL": "https://ollama.north3rnlight3r.com",
        "OLLAMA_MODEL": "aifred:latest",
        "AIFRED_CONTACT_EMAIL": "north3rnlight3rofficial@outlook.com"
      },
      "kv_namespaces": [
        { "binding": "AIFRED_REFERENCE_POOL", "id": "8a120701767e474f928d1af7037cd68a" },
        { "binding": "AIFRED_SALES_LOG", "id": "2c66da7795b54135a4d67e514b97491f" }
      ],
      "r2_buckets": [
        { "binding": "AIFRED_DOWNLOADS", "bucket_name": "aifred-downloads" },
        { "binding": "AIFRED_REFERENCE_BUCKET", "bucket_name": "aifred-reference-pool" }
      ],
      "d1_databases": [
        { "binding": "AIFRED_OPS", "database_name": "aifred-ops", "database_id": "60d95cd8-d1da-486c-b6fd-4bfedcd7bc47", "migrations_dir": "migrations" }
      ],
      "analytics_engine_datasets": [
        { "binding": "AIFRED_ANALYTICS", "dataset": "aifred_events_staging" }
      ],
      "queues": {
        "producers": [
          { "binding": "AIFRED_EVENTS_QUEUE", "queue": "aifred-events-staging" }
        ],
        "consumers": [
          { "queue": "aifred-events-staging", "max_batch_size": 100, "max_batch_timeout": 30, "max_retries": 3 }
        ]
      },
      "ratelimits": [
        { "name": "CHAT_RATE_LIMITER", "namespace_id": "4201", "simple": { "limit": 15, "period": 60 } },
        { "name": "ANALYTICS_RATE_LIMITER", "namespace_id": "4202", "simple": { "limit": 20, "period": 60 } },
        { "name": "ADMIN_LOGIN_RATE_LIMITER", "namespace_id": "4203", "simple": { "limit": 5, "period": 60 } },
        { "name": "INQUIRY_RATE_LIMITER", "namespace_id": "4204", "simple": { "limit": 5, "period": 60 } },
        { "name": "REFERENCE_RATE_LIMITER", "namespace_id": "4205", "simple": { "limit": 20, "period": 60 } },
        { "name": "ANALYSIS_RATE_LIMITER", "namespace_id": "4206", "simple": { "limit": 10, "period": 60 } },
        { "name": "ADMIN_RATE_LIMITER", "namespace_id": "4207", "simple": { "limit": 60, "period": 60 } }
      ]
    }
  }
}
