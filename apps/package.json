{
  "type": "module",
  "scripts": {
    "website:check": "node ../tools/check-source-integrity.mjs && node ../tools/check-website-modules.mjs && node ../tools/check-website-assets.mjs && node --test ../tests/website-backend.test.mjs",
    "website:dev": "wrangler pages dev . --cwd website",
    "website:deploy": "node ../tools/deploy-website.mjs main",
    "website:preview": "node ../tools/deploy-website.mjs recovery-completion"
  },
  "dependencies": {
    "esbuild": "0.28.2",
    "workerd": "1.20260829.1",
    "wrangler": "4.127.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20260829.1": true
  }
}
