{
  "type": "module",
  "scripts": {
    "archive:test": "node --test ../tests/archive.test.mjs",
    "website:check": "node website/tools/check-source-integrity.mjs && node website/tools/check-website-modules.mjs && node website/tools/check-website-assets.mjs && node --test ../tests/website-backend.test.mjs",
    "website:dev": "wrangler pages dev . --cwd website",
    "website:deploy": "node website/tools/deploy-website.mjs main",
    "website:preview": "node website/tools/deploy-website.mjs recovery-completion"
  },
  "dependencies": {
    "esbuild": "0.28.2",
    "workerd": "1.20260829.1",
    "wrangler": "4.137.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "workerd@1.20260829.1": true,
    "workerd@1.20260921.1": true
  }
}
