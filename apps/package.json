{
  "type": "module",
  "scripts": {
    "website:check": "node ../tools/check-source-integrity.mjs && node ../tools/check-website-modules.mjs && node --test ../tests/website-backend.test.mjs && node ../tools/generate-admin-command-reference.mjs --check && python ../scripts/common/check_repository.py",
    "website:dev": "wrangler pages dev . --cwd website",
    "website:deploy": "wrangler pages deploy . --cwd website --project-name=aifred-site --branch=main"
  },
  "dependencies": {
    "esbuild": "0.28.2",
    "workerd": "1.20260829.1",
    "wrangler": "4.127.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20260829.1": true
  }
}
