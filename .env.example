# AIFRED / North3rnLight3r local operator environment
#
# Copy this file to the AIFRED workspace root as `.env` and keep it local-only.
# Keep the populated file in the authoritative AIFRED_Official- repository root.
#
# This file is a NAME MAP, not a recommendation to reuse one secret everywhere.
# Keep Cloudflare, GitHub, admin-session, provider, and optional R2 S3 credentials distinct.
# Never commit the populated `.env`.

# -----------------------------------------------------------------------------
# Shared public API identity
# -----------------------------------------------------------------------------
AIFRED_PUBLIC_ORIGIN=https://north3rnlight3r.com
AIFRED_API_BASE_URL=https://north3rnlight3r.com/api
AIFRED_REFERENCE_POOL_URL=https://north3rnlight3r.com/api/v1/references

# -----------------------------------------------------------------------------
# Owner/admin authentication
# -----------------------------------------------------------------------------
# AIFRED_ADMIN_PASSWORD is local operator convenience only. Cloudflare receives
# the SHA-256 verifier, not the plaintext password.
AIFRED_ADMIN_USERNAME=
AIFRED_ADMIN_PASSWORD=
AIFRED_ADMIN_PASSWORD_SHA256=
AIFRED_ADMIN_SESSION_SECRET=

# -----------------------------------------------------------------------------
# Website/provider routing
# -----------------------------------------------------------------------------
AIFRED_CHAT_PROVIDER=ollama
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=aifred:latest
OLLAMA_API_TOKEN=
OLLAMA_ACCESS_CLIENT_ID=
OLLAMA_ACCESS_CLIENT_SECRET=
AIFRED_OLLAMA_PROXY_PORT=11435
AIFRED_OLLAMA_UPSTREAM=http://127.0.0.1:11434

# -----------------------------------------------------------------------------
# Local AifredIntelligenceHost provider overrides
# -----------------------------------------------------------------------------
# These are consumed by AifredIntelligenceHost. They are independent of the
# Cloudflare website provider configuration.
AIFRED_PROVIDER=ollama
# For the production AIFRED Worker use the OpenAI-compatible v1 root below.
# Local Ollama remains valid for local-first operation.
AIFRED_PROVIDER_ENDPOINT=https://north3rnlight3r.com/api/v1
AIFRED_PROVIDER_MODEL=aifred:latest
AIFRED_PROVIDER_API_KEY=

# -----------------------------------------------------------------------------
# GitHub repository operations
# -----------------------------------------------------------------------------
AIFRED_GITHUB_REPO=kaeganscott26/AIFRED_Official-
AIFRED_GITHUB_BRANCH=main
AIFRED_PLUGIN_REPO=kaeganscott26/AIFRED_Official-
AIFRED_PLUGIN_RELEASE_TAG=
GITHUB_TOKEN=

# -----------------------------------------------------------------------------
# Cloudflare account/deployment management
# -----------------------------------------------------------------------------
# Native Pages Git integration does not require CLOUDFLARE_API_TOKEN for each
# normal push/deploy. Keep these only for Wrangler/API-based operator tasks.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional S3-compatible R2 credentials for external upload tooling only.
# Pages/Workers use R2 bindings and do not need these keys at runtime.
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_ENDPOINT=

# -----------------------------------------------------------------------------
# Website/release metadata
# -----------------------------------------------------------------------------
AIFRED_RELEASE_VERSION=
AIFRED_CONTACT_EMAIL=north3rnlight3rofficial@outlook.com
AIFRED_EMAIL_FROM=sales@north3rnlight3r.com

# Optional/legacy compatibility fields. Leave blank unless a current component
# explicitly documents them.
AIFRED_ANALYTICS_API_TOKEN=
AIFRED_CHAT_SESSIONS=
